{
  "manifest_version": 3,
  "name": "Engineer Tab Organizer",
  "version": "0.1.0",
  "description": "AIを使わないルールベースのタブ整理。作業コンテキスト別にタブをグループ化します。",
  "permissions": ["tabs", "tabGroups", "storage"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Engineer Tab Organizer",
    "default_popup": "popup.html"
  },
  "commands": {
    "organize-now": {
      "suggested_key": { "default": "Ctrl+Shift+O", "mac": "Command+Shift+O" },
      "description": "今すぐ整理"
    },
    "undo-organize": {
      "description": "直前の整理を取り消す"
    }
  }
}
